<Window x:Class="MatchIt.MatchReplacement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MatchIt Match Replacement"
        Height="820"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MatchIt Match Replacement"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Process Profile:"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="DisplayName"
                      Height="28"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Contacts File:"/>
            <TextBox Grid.Column="1"
                     Margin="0,0,8,0"
                     Text="{Binding ContactsCsvPath, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>
            <Button Grid.Column="2"
                    Content="Browse..."
                    Height="28"
                    Command="{Binding BrowseContactsCommand}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Suppression File:"/>
            <TextBox Grid.Column="1"
                     Margin="0,0,8,0"
                     Text="{Binding SuppressionCsvPath, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>
            <Button Grid.Column="2"
                    Content="Browse..."
                    Height="28"
                    Command="{Binding BrowseSuppressionCommand}"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Output Folder:"/>
            <TextBox Grid.Column="1"
                     Margin="0,0,8,0"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"/>
            <Button Grid.Column="2"
                    Content="Browse..."
                    Height="28"
                    Command="{Binding BrowseOutputFolderCommand}"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Export Format:"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ExportFormats}"
                      SelectedItem="{Binding SelectedExportFormat}"
                      Height="28"
                      Margin="0,0,12,0"/>

            <Button Grid.Column="2"
                    Content="Run Process"
                    Width="120"
                    Height="32"
                    Command="{Binding RunProcessCommand}"/>

            <TextBlock Grid.Column="3"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding StatusText}"/>
        </Grid>

        <GroupBox Grid.Row="6" Header="Progress / Log" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ProgressLog}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Output Files" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding OutputFiles}"
                             SelectedItem="{Binding SelectedOutputFile}"
                             DisplayMemberPath="DisplayName"/>

                    <Button Grid.Row="1"
                            Margin="0,8,0,0"
                            Height="30"
                            Content="Preview Selected Output"
                            Command="{Binding PreviewSelectedOutputCommand}"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Preview">
                <DataGrid ItemsSource="{Binding PreviewRows}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>